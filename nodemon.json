{
  "watch": [
    "server.js",
    ".env"
  ],
  "ext": "js,env",
  "ignore": [
    ".git/**",
    "node_modules/**",
    "public/**",
    "frontend.js",
    "node-runtime.js",
    "*.html",
    "*.css",
    "published-projects.json",
