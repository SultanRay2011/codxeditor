# Production published-link storage. Use the internal PostgreSQL connection
# string supplied by your hosting provider.
DATABASE_URL=

# Optional writable directory for local file storage or a mounted persistent
# disk. Published links use this only when DATABASE_URL is not configured.
DATA_DIR=

# Keep this value stable across production deployments.
SESSION_RECOVERY_SECRET=

# GitHub OAuth application settings.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
GITHUB_OAUTH_SCOPE=repo read:user
